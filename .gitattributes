# Keep line endings LF everywhere. The dashboard JSON is generated by build.py
# on whatever machine happens to run it, and a CRLF round-trip turns a
# three-line threshold change into a diff of the entire file.
* text=auto eol=lf

# Generated build outputs. Collapsed in review because build.py is what you
# should be reading, but still committed so nobody needs Python to import a
# dashboard.
dashboards/**/dashboard.json linguist-generated=true
dashboards/**/dashboard.grafana-com.json linguist-generated=true
